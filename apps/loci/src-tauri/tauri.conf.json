{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loci",
  "version": "0.2.1",
  "identifier": "space.avicenna.loci",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5740",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Loci",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "A memory palace for everything you learn.",
    "longDescription": "Loci is a local-first spaced-repetition app that imports your Anki collection with its history intact and asks less of your day.",
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": { "installMode": "currentUser" }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
