<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Loci: paper by day, slate at night; the window background matches the page so launch never flashes white. -->
    <style name="Theme.loci_app" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/loci_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="colorPrimary">@color/loci_brass</item>
    </style>
</resources>
